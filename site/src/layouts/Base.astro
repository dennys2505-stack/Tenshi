---
import '../styles/global.css';
import { SITE_NAME, PUBLIC } from '../lib/data.js';
import { ui, pre } from '../lib/i18n.js';
import maps from '../data/maps.json';
import site from '../data/site.json';
// lang : 'fr' (défaut) ou 'en' ; alt : adresse de la même page dans l'autre langue (bouton FR/EN, site public seulement).
const { title, description: desc, image, crumbs = [], backdrop, lang = 'fr', alt } = Astro.props;
const u = ui(lang);
const description = desc ?? u.tagline;
const SITE_TAGLINE = u.tagline;
// Fond sur PC : image de la map de la page ; sinon la photo d'accueil choisie (site.json → fondAccueil) ;
// sinon un montage automatique des maps du map pool (pool: true dans maps.json), qui suit les rotations.
const fixe = backdrop ?? site.fondAccueil ?? null;
const pool = fixe ? [] : maps.filter((m) => m.pool);
const N = pool.length;
// Couleur d'accent propre à la map de la page (maps.json → accent : [thème sombre, thème clair]) ; sinon turquoise.
const acc = backdrop ? maps.find((m) => m.bg === backdrop)?.accent : undefined;
const bande = (i) => {
  const a = (i / N) * 100, b = ((i + 1) / N) * 100, d = 7; // d = inclinaison des bandes (en % de la largeur)
  return `polygon(${a + d - 2}% 0, ${b + d + 2}% 0, ${b + 2}% 100%, ${a - 2}% 100%)`;
};
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} – ${SITE_TAGLINE}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image && Astro.site ? new URL(image, Astro.site).href : image;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preload" href="/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin />
    {!PUBLIC && <meta name="robots" content="noindex" />}
    {PUBLIC && alt && Astro.site && <link rel="alternate" hreflang={lang} href={new URL(Astro.url.pathname, Astro.site).href} />}
    {PUBLIC && alt && Astro.site && <link rel="alternate" hreflang={lang === 'en' ? 'fr' : 'en'} href={new URL(alt, Astro.site).href} />}
    {PUBLIC && <script defer src="/_vercel/insights/script.js"></script>}
    <slot name="head" />
    {!PUBLIC && <script is:inline>
      // Numéros de line ups visibles seulement pour nous : ouvrir une page avec ?num=1 (désactiver avec ?num=0).
      try {
        var q = new URLSearchParams(location.search).get('num');
        if (q === '1') localStorage.setItem('tenshi_num', '1');
        if (q === '0') localStorage.removeItem('tenshi_num');
        if (localStorage.getItem('tenshi_num') === '1' || localStorage.getItem('tenshi_gh') || localStorage.getItem('tenshi_pw')) document.documentElement.classList.add('show-num');
      } catch (e) {}
    </script>}
  </head>
  <body class={backdrop ? 'bd-map' : fixe ? 'bd-photo' : 'bd-menu'} style={[fixe ? `--backdrop:url('${fixe}')` : '', acc ? `--acd:${acc[0]};--acl:${acc[1]}${acc[2] ? `;--tint:${acc[2]}` : ''}` : ''].join(';') || undefined}>
    {N > 0 && (
      <div class="montage" aria-hidden="true">
        {pool.map((m, i) => (
          <div style={`background-image:url('${m.bg}');clip-path:${bande(i)};--lum:${m.fondLum ?? 1}`}></div>
        ))}
        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
          {pool.slice(1).map((_, j) => { const x = ((j + 1) / N) * 100; return <line x1={x + 7} y1="0" x2={x} y2="100" />; })}
        </svg>
      </div>
    )}
    <header class="site-head">
      <a class="brand" href={`${pre(lang)}/`}>{SITE_NAME}</a>
      {PUBLIC && alt && <a class="lang-switch" href={alt} hreflang={lang === 'en' ? 'fr' : 'en'} lang={lang === 'en' ? 'fr' : 'en'} title={u.switchLabel}>{u.switchTo}</a>}
    </header>
    <main>
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Fil d'Ariane">
          <a href={`${pre(lang)}/`}>{u.home}</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">›</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      <slot />
    </main>
    {PUBLIC ? (
      <footer class="site-foot">
        <p lang="en">{SITE_NAME} was created under Riot Games' "Legal Jibber Jabber" policy using assets owned by Riot Games. Riot Games does not endorse or sponsor this project.</p>
        {u.footFr && <p>{u.footFr}</p>}
        <p><a href={lang === 'en' ? '/en/about/' : '/a-propos/'}>{u.about}</a> · {u.footFree}</p>
      </footer>
    ) : (
      <footer class="site-foot">
        {SITE_NAME} est un projet de fans. Il n'est pas affilié à Riot Games et ne reflète ni leurs avis ni ceux de personnes
        travaillant pour Riot Games. VALORANT et Riot Games sont des marques de Riot Games, Inc.
      </footer>
    )}
    <script is:inline>
    // Bouton « Partager » : partage natif du téléphone, sinon copie du lien.
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('.share'); if (!b) return;
      var url = location.origin + b.dataset.url, t = b.dataset.title;
      var done = function () { var o = b.textContent; b.textContent = b.dataset.done || 'Lien copié ✔'; setTimeout(function () { b.textContent = o; }, 1800); };
      if (navigator.share) navigator.share({ title: t, url: url }).catch(function () {});
      else if (navigator.clipboard) navigator.clipboard.writeText(url).then(done, function () { prompt('Lien :', url); });
      else prompt('Lien :', url);
    });
  </script>
  <script is:inline>
    // Petites vidéos en boucle des line ups : chargées et lancées seulement quand elles sont à l'écran (économise les données).
    (function () {
      var vs = document.querySelectorAll('.shots video[data-src]'); if (!vs.length) return;
      function on(v) { if (!v.src) v.src = v.dataset.src; var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      if (!('IntersectionObserver' in window)) { vs.forEach(on); return; }
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) on(e.target); else e.target.pause(); }); }, { rootMargin: '200px' });
      vs.forEach(function (v) { io.observe(v); });
    })();
  </script>
  <script is:inline>
    // Line ups en photos verticales (images de vidéo) : classe « portrait » pour agrandir la mini map sur PC.
    document.querySelectorAll('.shots').forEach(function (box) {
      var k = box.querySelector('figure.key img'); if (!k) return;
      function check() { if (k.naturalHeight > k.naturalWidth * 1.2) box.classList.add('portrait'); }
      if (k.complete) check(); else k.addEventListener('load', check);
    });
    // Clic sur une photo (ou la mini map) d'une line up : l'agrandit en plein écran, flèches pour passer à la suivante.
    (function () {
      var lb, c, t, list = [], cur = 0, x0 = null;
      function build() {
        lb = document.createElement('div'); lb.className = 'lb'; lb.hidden = true;
        lb.innerHTML = '<button type="button" class="lb-x" aria-label="Fermer">✕</button><button type="button" class="lb-p" aria-label="Précédente">‹</button><div class="lb-c"></div><p class="lb-t"></p><button type="button" class="lb-n" aria-label="Suivante">›</button>';
        document.body.appendChild(lb); c = lb.querySelector('.lb-c'); t = lb.querySelector('.lb-t');
        lb.addEventListener('click', function (e) {
          if (e.target.closest('.lb-p')) return show(cur - 1);
          if (e.target.closest('.lb-n')) return show(cur + 1);
          if (e.target === lb || e.target.closest('.lb-x')) close();
        });
        lb.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
        lb.addEventListener('touchend', function (e) { if (x0 === null) return; var d = e.changedTouches[0].clientX - x0; x0 = null; if (Math.abs(d) > 50) show(cur + (d < 0 ? 1 : -1)); });
      }
      function show(i) {
        cur = (i + list.length) % list.length; var f = list[cur];
        var media = f.querySelector('.mm') || f.querySelector('img');
        c.innerHTML = ''; c.appendChild(media.cloneNode(true));
        var cap = f.querySelector('figcaption'); t.textContent = cap ? cap.textContent : '';
        var many = list.length > 1; lb.querySelector('.lb-p').hidden = !many; lb.querySelector('.lb-n').hidden = !many;
      }
      function close() { lb.hidden = true; document.documentElement.style.overflow = ''; }
      document.addEventListener('click', function (e) {
        var m = e.target.closest && e.target.closest('.shots img, .shots .mm'); if (!m) return;
        var f = m.closest('figure'), box = m.closest('.shots'); if (!f || !box) return;
        if (!lb) build();
        list = Array.prototype.slice.call(box.querySelectorAll(':scope > figure'));
        lb.hidden = false; document.documentElement.style.overflow = 'hidden'; show(list.indexOf(f));
      });
      document.addEventListener('keydown', function (e) {
        if (!lb || lb.hidden) return;
        if (e.key === 'Escape') close(); else if (e.key === 'ArrowLeft') show(cur - 1); else if (e.key === 'ArrowRight') show(cur + 1);
      });
    })();
  </script>
</body>
</html>
