---
// Accueil (FR : src/pages/index.astro, EN : src/pages/en/index.astro).
import Base from '../layouts/Base.astro';
import Tile from '../components/MapTile.astro';
import { maps, SITE_NAME, lineups, allLineups, hiddenLineups, PUBLIC } from '../lib/data.js';
import { ui } from '../lib/i18n.js';
const { lang = 'fr' } = Astro.props;
const u = ui(lang);
const aVerifier = allLineups.filter((l) => !l.checked && !l.hidden).length;
const total = lineups.length;
// Map pool : à mettre à jour dans maps.json (« pool »: true) à chaque changement.
const pool = maps.filter((m) => m.pool);
const autres = maps.filter((m) => !m.pool);
---
<Base description={u.homeDesc(total)} lang={lang} alt={lang === 'en' ? '/' : '/en/'}>
  <div class="top"><h1>{SITE_NAME}</h1></div>
  <p class="lead">{u.lead}</p>
  {!PUBLIC && <div class="admin-only adminbox">
    <b>Espace admin</b>
    <a href="/admin/?vue=averifier">📋 Suivi : {aVerifier} à vérifier</a>
    <a href="/coulisses/">🙈 Coulisses : {hiddenLineups.length} cachées</a>
    <a href="/admin/">Toutes les line ups</a>
  </div>}
  <h2>{u.pool}</h2>
  <p class="lead small">{u.poolLead(pool.length)}</p>
  <div class="grid maps" style="margin-top:12px">
    {pool.map((m) => <Tile m={m} lang={lang} />)}
  </div>
  {autres.length > 0 && (<>
    <h2 class="autres">{u.other}</h2>
    <p class="lead small">{u.otherLead}</p>
    <div class="grid maps" style="margin-top:12px">
      {autres.map((m) => <Tile m={m} lang={lang} />)}
    </div>
  </>)}
</Base>
