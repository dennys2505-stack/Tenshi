---
// Le repère écrit est en haut : le bas de l'image (HUD, icônes) sert souvent de repère et ne doit pas être caché.
// Mode match (2e écran) : l'écran coupé en 4 cases, chacune affiche la mini map ou une line up,
// au choix et indépendamment (‹ › ou menu). Choix gardés dans le navigateur (localStorage).
// Vue partagée FR / EN (pages : src/pages/[map]/[agent]/match.astro et src/pages/en/…/match.astro).
import { mapByName, lineupsFor, slug, shownImages, imagesOk, agentUrl, PUBLIC } from '../lib/data.js';
import { ui, tx, sideL, siteL } from '../lib/i18n.js';
const { mapName, agentName, lang = 'fr' } = Astro.props;
const u = ui(lang);
const map = mapByName(mapName);
const list = lineupsFor(mapName, agentName);
const AIM = /rep[eè]re|vis[eé]e|viser|crosshair/i;
const POS = /position|place|d[ée]part|accroupi/i;
const ORD = { Attaque: 0, 'Attaque et défense': 1, 'Défense': 2 };
const sorted = [...list].sort((a, b) => (ORD[a.side] ?? 3) - (ORD[b.side] ?? 3) || String(a.site ?? '').localeCompare(String(b.site ?? '')) || (a.num ?? 0) - (b.num ?? 0));
const cap1 = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const data = sorted.map((l, i) => {
  const imgs = shownImages(l);
  const aim = imgs.find((x) => AIM.test(x.cap ?? '')) ?? imgs[0];
  const pos = imgs.find((x) => x !== aim && POS.test(x.cap ?? '')) ?? null;
  const rep = tx(lang, 'caps', aim?.cap ?? '').replace(/^\s*(rep[eè]re( de vis[eé]e)?|vis[eé]e|aim( reference)?)\s*:?\s*/i, '');
  const notes = (l.notes ?? []).map((n) => tx(lang, 'notes', n)).join(' · ');
  return {
    n: i + 1, id: l.id, side: sideL(lang, l.side), site: siteL(lang, l.site ?? ''), title: tx(lang, 'titles', l.title),
    hiddenImg: PUBLIC && !imagesOk(l) && (l.images ?? []).length > 0,
    rep: cap1([notes, rep].filter(Boolean).join(' · ')),
    aim: aim?.src ?? '', pos: pos?.src ?? '', impact: l.impact ?? null,
    from: l.from ?? null, to: l.to ?? null,
  };
});
const back = agentUrl(mapName, agentName, lang);
const T = { case: u.mCase, prev: u.mPrev, next: u.mNext, noImg: u.mNoImg, noImgPublic: u.mNoImgPublic, pos: u.mPos, aim: u.mAim, map: lang === 'en' ? 'Minimap' : 'Mini map' };
const key = `match:${slug(mapName)}:${slug(agentName)}`;
const [W, H] = map?.dim ?? [640, 640];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{u.mTitle} · {agentName} · {mapName}</title>
<style is:global>
@font-face{font-family:"Barlow Condensed";font-weight:600;src:url(/fonts/barlow-condensed-600.woff2) format("woff2")}
@font-face{font-family:"Barlow Condensed";font-weight:700;src:url(/fonts/barlow-condensed-700.woff2) format("woff2")}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#0b131b;color:#ece8e1;font-family:"Barlow Condensed","Arial Narrow",sans-serif}
.grid{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:6px;height:100vh;width:100vw}
.q{position:relative;overflow:hidden;background:radial-gradient(600px 300px at 0% 0%,rgba(63,224,197,.12),transparent 70%),#0f1923}
.bar{position:absolute;top:0;left:0;right:0;z-index:2;height:52px;padding:0 10px 0 14px;display:flex;align-items:center;gap:10px;background:linear-gradient(180deg,rgba(15,25,35,.95),rgba(15,25,35,.72));border-bottom:1px solid rgba(63,224,197,.35)}
.badge{width:36px;height:36px;flex:none;border-radius:50%;background:#3fe0c5;color:#0f1923;font-size:20px;font-weight:700;display:flex;align-items:center;justify-content:center}
.ttl{font-size:24px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.tag{border:1.5px solid #fff;padding:2px 10px;font-size:16px;font-weight:700;letter-spacing:1.5px;flex:none;text-transform:uppercase}
.ctl{margin-left:auto;display:flex;align-items:center;gap:6px;flex:none}
.ctl button{width:44px;height:40px;border:1.5px solid #3fe0c5;background:transparent;color:#3fe0c5;font:700 22px/1 inherit;cursor:pointer}
.ctl select{height:40px;max-width:260px;background:#1b2633;color:#ece8e1;border:1.5px solid #3fe0c5;font:600 18px inherit;padding:0 8px;cursor:pointer}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.full{position:absolute;inset:52px 0 0;width:100%;height:calc(100% - 52px);}
.has-foot .full{top:98px;height:calc(100% - 98px)}
.full{object-fit:contain;display:block}
.blur{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:blur(18px) brightness(.45);transform:scale(1.1)}
.noimg{position:absolute;inset:52px 0 0;display:flex;align-items:center;justify-content:center;text-align:center;color:#a3acb8;font-size:24px;letter-spacing:1px;padding:20px}
.pos{position:absolute;left:14px;bottom:14px;margin:0;width:24%;min-width:180px;background:rgba(15,25,35,.88);border:1px solid rgba(63,224,197,.5)}
.pos img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.pos figcaption{font-size:15px;font-weight:700;letter-spacing:1.5px;padding:3px 8px;color:#3fe0c5}
.foot{position:absolute;left:0;right:0;top:52px;z-index:1;padding:8px 16px;background:linear-gradient(180deg,rgba(15,25,35,.85),rgba(15,25,35,.55));display:flex;align-items:center;gap:12px;font-size:24px;font-weight:600}
.foot::before{content:"";width:4px;align-self:stretch;background:#3fe0c5}
.chrono{margin-left:auto;color:#3fe0c5;font-weight:700;white-space:nowrap}
.mapq{position:absolute;inset:52px 0 0;display:flex;align-items:center;gap:22px;padding:12px 20px}
.mm{position:relative;height:100%;aspect-ratio:1/1;flex:none;background:#0b131b;border:1px solid rgba(63,224,197,.35)}
.mm img,.mm svg{position:absolute;inset:0;width:100%;height:100%}
.lst{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;min-width:0;overflow:auto;max-height:100%}
.lst li{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:600;line-height:1.1}
.lst .badge{width:30px;height:30px;font-size:16px}
.lst small{display:block;color:#a3acb8;font-size:15px;letter-spacing:1px;text-transform:uppercase}
.back{position:fixed;right:8px;bottom:8px;z-index:5;font-size:15px;color:#a3acb8;background:rgba(15,25,35,.85);padding:6px 10px;opacity:.55;display:flex;gap:8px;align-items:center}
.back:hover,.back:focus-within{opacity:1}
.back a{color:#3fe0c5;text-decoration:none}
.back label{display:flex;gap:6px;align-items:center;cursor:pointer}
</style>
</head>
<body>
<main class="grid" id="grid" aria-label={`${u.mTitle} ${agentName} ${u.on} ${mapName}`}></main>
<div class="back"><label><input type="checkbox" id="remember"> {u.mRemember}</label> · <a href={back}>{u.mQuit}</a></div>
<script is:inline define:vars={{ data, mapName, agentName, minimap: map?.minimap ?? '', W, H, key, T }}>
const values = ['map', ...data.map((l) => String(l.n))];
// Choix des cases : gardés pour la session (onglet) ; sur l'appareil seulement si la case « Retenir » est cochée.
let remember = false, picks;
try { remember = localStorage.getItem('match:remember') === '1'; } catch (e) {}
try { picks = JSON.parse((remember ? localStorage : sessionStorage).getItem(key)); } catch (e) {}
if (!Array.isArray(picks) || picks.length !== 4) picks = [0, 1, 2, 3].map((i) => values[i] ?? 'map');
picks = picks.map((p) => (values.includes(p) ? p : 'map'));
const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const byN = Object.fromEntries(data.map((l) => [String(l.n), l]));
const tag = (l) => `${l.side}${l.site ? ' · ' + l.site : ''}`;
function mapSvg() {
  const s = W * 0.006;
  return `<svg viewBox="0 0 ${W} ${H}" aria-hidden="true"><defs><marker id="ah" markerWidth="10" markerHeight="10" refX="7" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#3fe0c5"/></marker></defs>` +
    data.filter((l) => l.from).map((l) => {
      const fx = l.from[0] * W, fy = l.from[1] * H;
      const line = l.to ? `<line x1="${fx}" y1="${fy}" x2="${l.to[0] * W}" y2="${l.to[1] * H}" stroke="#3fe0c5" stroke-width="${s}" stroke-dasharray="${s * 2.4} ${s * 1.6}" marker-end="url(#ah)"/><circle cx="${l.to[0] * W}" cy="${l.to[1] * H}" r="${W * 0.02}" fill="rgba(255,70,85,.25)" stroke="#ff4655" stroke-width="${s * 0.8}"/>` : '';
      return `${line}<circle cx="${fx}" cy="${fy}" r="${W * 0.026}" fill="#3fe0c5"/><text x="${fx}" y="${fy + W * 0.011}" text-anchor="middle" font-family="Barlow Condensed" font-size="${W * 0.032}" font-weight="700" fill="#0f1923">${l.n}</text>`;
    }).join('') + '</svg>';
}
function quad(i) {
  const v = picks[i];
  const l = byN[v];
  const opts = values.map((x) => `<option value="${x}"${x === v ? ' selected' : ''}>${x === 'map' ? T.map : esc(byN[x].n + ' · ' + tag(byN[x]) + ' · ' + byN[x].title)}</option>`).join('');
  const bar = `<div class="bar"><span class="badge">${l ? l.n : 'M'}</span><span class="ttl">${l ? esc(l.title) : esc(`${mapName} · ${agentName}`)}</span><span class="tag">${l ? esc(tag(l)) : T.map}</span>
    <div class="ctl"><button data-i="${i}" data-d="-1" aria-label="${T.case} ${i + 1} : ${T.prev}">‹</button><label class="vh" for="s${i}">${T.case} ${i + 1}</label><select id="s${i}" data-i="${i}">${opts}</select><button data-i="${i}" data-d="1" aria-label="${T.case} ${i + 1} : ${T.next}">›</button></div></div>`;
  if (!l) {
    return bar + `<div class="mapq">${minimap ? `<div class="mm"><img src="${minimap}" alt="${T.map} ${esc(mapName)}">${mapSvg()}</div>` : ''}<ul class="lst">${data.map((x) => `<li><span class="badge">${x.n}</span><span>${esc(x.title)}<small>${esc(tag(x))}</small></span></li>`).join('')}</ul></div>`;
  }
  const img = l.aim ? `<img class="blur" src="${l.aim}" alt=""><img class="full" src="${l.aim}" alt="${T.aim} : ${esc(l.title)}">` : `<div class="noimg">${l.hiddenImg ? T.noImgPublic : T.noImg}</div>`;
  const pos = l.pos ? `<figure class="pos"><img src="${l.pos}" alt="Position"><figcaption>${T.pos}</figcaption></figure>` : '';
  const chrono = l.impact ? `<span class="chrono">⏱ ${(document.documentElement.lang === 'en' ? String(l.impact) : String(l.impact).replace('.', ','))} s</span>` : '';
  return img + bar + pos + (l.rep || chrono ? `<div class="foot"><span>${esc(l.rep)}</span>${chrono}</div>` : '');
}
const grid = document.getElementById('grid');
function render() {
  grid.innerHTML = picks.map((v, i) => `<section class="q${byN[v] && (byN[v].rep || byN[v].impact) ? ' has-foot' : ''}" aria-label="${T.case} ${i + 1}">${quad(i)}</section>`).join('');
  try { (remember ? localStorage : sessionStorage).setItem(key, JSON.stringify(picks)); } catch (e) {}
}
grid.addEventListener('click', (e) => {
  const b = e.target.closest('button[data-d]');
  if (!b) return;
  const i = +b.dataset.i, k = values.indexOf(picks[i]);
  picks[i] = values[(k + +b.dataset.d + values.length) % values.length];
  render();
});
grid.addEventListener('change', (e) => {
  const s = e.target.closest('select[data-i]');
  if (!s) return;
  picks[+s.dataset.i] = s.value;
  render();
});
const rem = document.getElementById('remember');
rem.checked = remember;
rem.addEventListener('change', () => {
  remember = rem.checked;
  try {
    if (remember) localStorage.setItem('match:remember', '1');
    else { localStorage.removeItem('match:remember'); Object.keys(localStorage).filter((k) => k.startsWith('match:')).forEach((k) => localStorage.removeItem(k)); }
  } catch (e) {}
  render();
});
render();
</script>
</body>
</html>
