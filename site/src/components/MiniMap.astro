---
// Mini map avec le point de départ (point blanc) et l'arrivée (cible, ou icône de reveal pour Fade et Sova).
import abilities from '../data/abilities.json';
const { lineup: l, map: m } = Astro.props;
const isRev = l.reveal && (l.agent === 'Fade' || l.agent === 'Sova');
const revIcon = l.agent === 'Sova' ? '/img/icons/sova-reveal.png' : '/img/icons/reveal.png';
// Brimstone : l'arrivée est dessinée comme une molly en feu.
const isMolly = !isRev && l.agent === 'Brimstone';
const marks = (l.marks ?? []).filter((k) => k?.p);
const withOverlay = Boolean(m?.minimap && (l.from || l.to || marks.length));
const [W, H] = m?.dim ?? [640, 640];
const hasFrom = withOverlay && Boolean(l.from);
const x = hasFrom ? l.from[0] * W : 0;
const y = hasFrom ? l.from[1] * H : 0;
const hasTo = withOverlay && Boolean(l.to);
const X = hasTo ? l.to[0] * W : 0;
const Y = hasTo ? l.to[1] * H : 0;
const r = W * 0.011, s = W * 0.004, t = W * 0.02;
// Utilitaires posés sur la carte (sentinelles) : icônes et noms dans data/abilities.json.
const ABIL = (abilities[l.agent] ?? []);
const ICON = Object.fromEntries(ABIL.map((a) => [a.key, a.icon]));
const NOM = Object.fromEntries(ABIL.map((a) => [a.key, a.label.toLowerCase()]));
const used = [...new Set(marks.map((k) => k.t))].filter((k) => NOM[k]);
const caption = marks.length
  ? `Mini map : ${used.map((k) => NOM[k]).join(', ')}${l.from ? ` · point = position de ${l.agent}` : ''}`
  : isRev
  ? 'Mini map : point = départ, icône = zone de retombée de la reveal'
  : isMolly
  ? 'Mini map : point = départ, feu = arrivée de la molly'
  : 'Mini map : point = départ, cible = arrivée';
---
{withOverlay && (
  <figure>
    <div class="mm">
      <img src={m.minimap} alt={`Mini map ${l.map}`} loading="lazy" />
      <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        {hasTo && isRev && (
          <image href={revIcon} x={X - t * 1.4} y={Y - t * 1.4} width={t * 2.8} height={t * 2.8}
            style="filter:drop-shadow(0 0 2px #000) drop-shadow(0 0 1px #000)" />
        )}
        {hasTo && isMolly && (
          <image href="/img/icons/brimstone-molly.png" x={X - t * 1.8} y={Y - t * 1.8} width={t * 3.6} height={t * 3.6} />
        )}
        {hasTo && !isRev && !isMolly && (
          <>
            <circle cx={X} cy={Y} r={t} fill="none" stroke="#111" stroke-width={s * 2.6} />
            <circle cx={X} cy={Y} r={t} fill="none" stroke="#fff" stroke-width={s * 1.2} />
            <circle cx={X} cy={Y} r={t * 0.45} fill="none" stroke="#111" stroke-width={s * 2.6} />
            <circle cx={X} cy={Y} r={t * 0.45} fill="none" stroke="#fff" stroke-width={s * 1.2} />
            <circle cx={X} cy={Y} r={s * 0.9} fill="#fff" stroke="#111" stroke-width={s * 0.5} />
          </>
        )}
        {hasFrom && <circle cx={x} cy={y} r={r} fill="#fff" stroke="#111" stroke-width={s} />}
        {marks.map((k) => ICON[k.t] && (
          <>
            <circle cx={k.p[0] * W} cy={k.p[1] * H} r={t * 1.15} fill="#111" fill-opacity="0.85" stroke="#fff" stroke-width={s * 0.6} />
            <image href={ICON[k.t]} x={k.p[0] * W - t * 0.85} y={k.p[1] * H - t * 0.85} width={t * 1.7} height={t * 1.7} />
          </>
        ))}
      </svg>
    </div>
    <figcaption>{caption}</figcaption>
  </figure>
)}
{!withOverlay && l.minimap && (
  <figure>
    <img src={l.minimap} alt="Mini map" loading="lazy" />
    <figcaption>{caption}</figcaption>
  </figure>
)}
