---
import MiniMap from './MiniMap.astro';
import { lineupUrl, mapByName, abilitiesOf, shownImages, imagesOk, creditOf, videoHost, PUBLIC } from '../lib/data.js';
import { ui, tx, sideL, siteL } from '../lib/i18n.js';
const { lineup: l, detail = false, agent, lang = 'fr' } = Astro.props;
const u = ui(lang);
const abs = abilitiesOf(l, agent ?? l.agent).join(' ');
const m = mapByName(l.map);
const Heading = detail ? 'h1' : 'h2';
const title = tx(lang, 'titles', l.title);
// La photo de visée (« Repère… » ou fichier « visee ») passe en premier, en grand ; sinon la 1re photo.
// Site public : seulement les photos autorisées (voir shownImages dans lib/data.js).
const imgs = shownImages(l);
let k = imgs.findIndex((i) => /^rep[eè]re/i.test(i.cap ?? '') || /visee/i.test(i.src ?? ''));
if (k < 0) k = 0;
const ordered = imgs.length ? [imgs[k], ...imgs.filter((_, j) => j !== k)] : [];
const sansPhotos = PUBLIC && !imagesOk(l) && (l.images ?? []).length > 0;
const credit = creditOf(l, lang);
---
<article class="card" id={l.id} data-side={l.side} data-site={l.site} data-ab={abs}>
  {!PUBLIC && l.num && <a class="num" href={`/admin/?edit=${l.id}`} title="Modifier (admin)">#{l.num} {l.checked ? '✔' : '✎'}</a>}
  <p class="side-tag">{sideL(lang, l.side)}{l.site ? ` · ${siteL(lang, l.site)}` : ''}</p>
  <Heading>{detail ? title : <a href={lineupUrl(l, lang)}>{title}</a>}</Heading>
  {(l.also ?? []).length > 0 && <p class="meta-line">{u.alsoFor} {[l.agent, ...l.also].join(', ')}</p>}
  {(l.notes ?? []).length > 0 && (
    <div class="ind">{l.notes.map((n) => <p>{tx(lang, 'notes', n)}</p>)}</div>
  )}
  <div class="shots">
    {ordered.map((i, j) => (
      <figure class={j === 0 ? 'key' : undefined}>
        <img class="p" src={i.src} alt={`${l.agent} ${u.on} ${l.map} – ${tx(lang, 'caps', i.cap)}`} loading="lazy" />
        {i.cap && <figcaption>{tx(lang, 'caps', i.cap)}</figcaption>}
      </figure>
    ))}
    <MiniMap lineup={l} map={m} lang={lang} />
  </div>
  {sansPhotos && l.video && (
    <p class="credit">{u.noImg}</p>
  )}
  <div class="actions">
    {l.video && <a class="btn vid" href={l.video} target="_blank" rel="noopener noreferrer"><span>{PUBLIC ? u.videoOn(videoHost(l.video)) : u.video}</span></a>}
    {!l.hidden && <button type="button" class="btn ghost share" data-url={lineupUrl(l, lang)} data-title={`${title} (${l.agent} · ${l.map})`} data-done={u.copied}>{u.share}</button>}
  </div>
  {credit && <p class="credit">{credit}</p>}
</article>
