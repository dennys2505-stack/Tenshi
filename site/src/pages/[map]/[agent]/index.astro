---
import Base from '../../../layouts/Base.astro';
import LineupCard from '../../../components/LineupCard.astro';
import { lineups, maps, mapByName, agentInfo, lineupsFor, slug, count, mapUrl, agentsOf, abilitiesOf, abilityInfo } from '../../../lib/data.js';
export function getStaticPaths() {
  const pairs = new Map();
  for (const l of lineups) for (const a of agentsOf(l)) pairs.set(`${l.map}|${a}`, [l.map, a]);
  return [...pairs.values()].map(([map, agent]) => ({
    params: { map: slug(map), agent: slug(agent) },
    props: { mapName: map, agentName: agent },
  }));
}
const { mapName, agentName } = Astro.props;
const list = lineupsFor(mapName, agentName);
const uniq = (a) => [...new Set(a)];
const sides = uniq(list.flatMap((l) => l.side === 'Attaque et défense' ? ['Attaque', 'Défense'] : [l.side]));
const sites = uniq(list.map((l) => l.site).filter(Boolean));
const abKeys = uniq(list.flatMap((l) => abilitiesOf(l, agentName)));
import abilitiesData from '../../../data/abilities.json';
const abs = (abilitiesData[agentName] ?? []).filter((a) => abKeys.includes(a.key));
const map = mapByName(mapName);
const agent = agentInfo(agentName);
---
<Base
  title={`${agentName} sur ${mapName} – line ups`}
  description={`${count(list.length)} pour ${agentName} sur ${mapName} (Valorant) : position de départ, visée et arrivée.`}
  image={agent.bg ?? map?.bg}
  crumbs={[{ label: mapName, href: mapUrl(mapName) }, { label: agentName }]}
>
  <div class="top"><h1>{agentName} · {mapName}</h1><a class="btn ghost match-btn" href="match/" title="Écran coupé en 4 cases, pour un 2e écran">Mode match</a></div>
  {sides.length > 1 && (
    <div class="chips" role="group" aria-label="Côté" data-filter="side">
      <button class="chip" data-v="Tous" aria-pressed="true">Tous</button>
      {sides.map((s) => <button class="chip" data-v={s} aria-pressed="false">{s}</button>)}
    </div>
  )}
  {sites.length > 1 && (
    <div class="chips" role="group" aria-label="Site" data-filter="site">
      <button class="chip" data-v="Tous" aria-pressed="true">Tous</button>
      {sites.map((s) => <button class="chip" data-v={s} aria-pressed="false">{s}</button>)}
    </div>
  )}
  {abs.length > 1 && (
    <div class="chips" role="group" aria-label="Compétence" data-filter="ab">
      <button class="chip" data-v="Tous" aria-pressed="true">Tous</button>
      {abs.map((a) => <button class="chip" data-v={a.key} aria-pressed="false"><img class="chip-ic" src={a.icon} alt="" />{a.label}</button>)}
    </div>
  )}
  <div id="list">
    {list.map((l) => <LineupCard lineup={l} agent={agentName} />)}
  </div>
  <p class="empty" id="none" hidden>Aucune line up avec ces filtres.</p>
</Base>
<script>
  // Filtres côté / site / compétence (le contenu reste lisible sans JavaScript)
  const state = { side: 'Tous', site: 'Tous', ab: 'Tous' };
  const cards = [...document.querySelectorAll('#list article')];
  const none = document.getElementById('none');
  function apply() {
    let shown = 0;
    for (const c of cards) {
      const ok = (state.side === 'Tous' || c.dataset.side === state.side || (c.dataset.side === 'Attaque et défense' && (state.side === 'Attaque' || state.side === 'Défense'))) && (state.site === 'Tous' || c.dataset.site === state.site) && (state.ab === 'Tous' || (c.dataset.ab || '').split(' ').includes(state.ab));
      c.hidden = !ok;
      if (ok) shown++;
    }
    if (none) none.hidden = shown > 0;
  }
  document.querySelectorAll('[data-filter]').forEach((group) => {
    group.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (!b) return;
      state[group.dataset.filter] = b.dataset.v;
      group.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    });
  });
</script>
<style>
  .match-btn{margin:0 0 0 auto}
  .chip-ic{width:18px;height:18px;object-fit:contain;vertical-align:-4px;margin-right:6px}
</style>
