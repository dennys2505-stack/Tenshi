---
import Base from '../../../layouts/Base.astro';
import LineupCard from '../../../components/LineupCard.astro';
import { lineups, slug, mapUrl, agentUrl, mapByName, shownImages } from '../../../lib/data.js';
export function getStaticPaths() {
  return lineups.map((l) => ({
    params: { map: slug(l.map), agent: slug(l.agent), id: l.id },
    props: { lineup: l },
  }));
}
const { lineup: l } = Astro.props;
---
<Base
  backdrop={mapByName(l.map)?.bg}
  title={`${l.title} – ${l.agent} sur ${l.map}`}
  description={`Line up ${l.agent} sur ${l.map} (${l.side}${l.site ? `, site ${l.site}` : ''}) : ${l.title}.`}
  image={shownImages(l)[0]?.src}
  crumbs={[
    { label: l.map, href: mapUrl(l.map) },
    { label: l.agent, href: agentUrl(l.map, l.agent) },
    { label: l.title },
  ]}
>
  <LineupCard lineup={l} detail />
  <a class="back" href={agentUrl(l.map, l.agent)}>← Toutes les line ups de {l.agent} sur {l.map}</a>
</Base>
