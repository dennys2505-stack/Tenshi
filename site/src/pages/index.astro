---
import Base from '../layouts/Base.astro';
import { maps, lineupsFor, count, mapUrl, SITE_NAME, lineups } from '../lib/data.js';
const total = lineups.length;
---
<Base
  description={`${total} line ups Valorant classées par map puis par agent : position de départ, visée et zone d'arrivée.`}
>
  <div class="top"><h1>{SITE_NAME}</h1></div>
  <p class="lead">Choisis une map, puis ton agent, et retrouve toutes les line ups : où te placer, quoi viser, où ça atterrit.</p>
  <h2>Choisis une map</h2>
  <div class="grid maps" style="margin-top:12px">
    {maps.map((m) => {
      const n = lineupsFor(m.name).length;
      return m.bg ? (
        <a class="tile mapbg" href={mapUrl(m.name)} aria-label={`${m.name}, ${count(n)}`} style={`background-image:url('${m.bg}')`}>
          {!m.named && <b class="nm">{m.name}</b>}
          <span>{count(n)}</span>
        </a>
      ) : (
        <a class="tile" href={mapUrl(m.name)}>
          <b>{m.name}</b>
          <span>{count(n)}</span>
        </a>
      );
    })}
  </div>
</Base>
